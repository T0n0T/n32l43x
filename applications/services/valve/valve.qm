<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.1" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="Shared" stereotype="0x00">
  <attribute name="AppSignals" type="enum" visibility="0x04" properties="0x00">
   <code>{
    LOCK_SIG = Q_USER_SIG,
    UNLOCK_SIG,
    VALVE_DAILY_SIG,
    VALVE_UPDATE_SIG,
    VALVE_PERSIST_SIG,
    VALVE_EXIT_SIG,
    VALVE_CMD_PARSE_SIG,
    VALVE_REFACTORY_SIG,
    VALVE_CONFIG_WRITE_SIG,
    VALVE_CONFIG_READ_SIG,
    VALVE_TUNNING_START_SIG,
    VALVE_TUNNING_END_SIG,
    VALVE_INFO_READ_SIG,
    MAX_PUB_SIG,

    TIMEOUT_SIG,
    MAX_SIG,
};</code>
  </attribute>
  <attribute name="Sleep_bits" type="uint32_t" visibility="0x00" properties="0x00"/>
  <attribute name="Sleep_slotbit" type="enum" visibility="0x04" properties="0x00">
   <code>{
    LOCK_BIT    = 1 &lt;&lt; 0,
    COUNTER_BIT = 1 &lt;&lt; 1,
    HANDLER_BIT = 1 &lt;&lt; 2,
    CONFIG_BIT  = 1 &lt;&lt; 3,
};</code>
  </attribute>
  <operation name="Sleep_request" type="void" visibility="0x00" properties="0x02">
   <parameter name="bit" type="uint32_t"/>
   <code>Sleep_bits |= bit;</code>
  </operation>
  <operation name="Sleep_release" type="void" visibility="0x00" properties="0x02">
   <parameter name="bit" type="uint32_t"/>
   <code>Sleep_bits &amp;= ~bit;</code>
  </operation>
  <class name="ValveVal">
   <attribute name="total_ticks" type="int32_t" visibility="0x00" properties="0x00"/>
  </class>
  <attribute name="ValveEvtType" type="enum" visibility="0x04" properties="0x00">
   <code>{
    VALVE_VALUE,
    VALVE_CMD,
};</code>
  </attribute>
  <attribute name="(*EvtHandle)(void*)" type="typedef void " visibility="0x04" properties="0x00"/>
  <class name="ValveEvt" superclass="qpc::QEvt">
   <attribute name="msg" type="void *" visibility="0x00" properties="0x00"/>
   <attribute name="handle" type="EvtHandle" visibility="0x00" properties="0x00"/>
   <attribute name="evtType" type="enum ValveEvtType" visibility="0x00" properties="0x00"/>
  </class>
  <class name="ValveValStore">
   <attribute name="flag" type="uint32_t" visibility="0x00" properties="0x00"/>
   <attribute name="val" type="ValveVal" visibility="0x00" properties="0x00"/>
  </class>
 </package>
 <package name="AOs" stereotype="0x02">
  <class name="ValveCounter" superclass="qpc::QActive">
   <documentation>Trigger by timeout, then collect hall sensor data and decode it. If there's a leagal update action,will publish event to ValveHandler</documentation>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="inst" type="ValveCounter" visibility="0x00" properties="0x01"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>QActive_subscribe(&amp;me-&gt;super, LOCK_SIG);
QActive_subscribe(&amp;me-&gt;super, UNLOCK_SIG);</action>
     <initial_glyph conn="26,14,5,1,18,7,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Wait">
     <entry brief="set sleep bits 1">Sleep_release(COUNTER_BIT);</entry>
     <exit brief="set sleep bits 0">Sleep_request(COUNTER_BIT);</exit>
     <tran trig="UNLOCK" target="../../2">
      <tran_glyph conn="42,25,1,1,2,13,-2">
       <action box="2,0,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="28,17,14,10">
      <entry box="0,3,4,2"/>
      <exit box="0,5,4,2"/>
     </state_glyph>
    </state>
    <state name="Work">
     <entry brief="switch on hall sensors; start timer to handle sensor data;">hall_set_ctr(ENABLE);
QTimeEvt_armX(&amp;me-&gt;timeEvt, 1, 1);</entry>
     <exit brief="stop timer; switch off hall sensors;">QTimeEvt_disarm(&amp;me-&gt;timeEvt);
hall_set_ctr(DISABLE);</exit>
     <tran trig="LOCK" target="../../1">
      <tran_glyph conn="28,38,3,3,-2,-13,2">
       <action box="-10,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TIMEOUT">
      <action>static uint8_t last_state = 0;
uint8_t        new_state  = read_sensor_state();
if (new_state != last_state &amp;&amp; is_valid_state(&amp;new_state)) {
    // 检查方向并更新旋转计数
    if (is_valid_state(&amp;last_state)) {
        int8_t dir = check_direction(&amp;last_state, &amp;new_state);
        if (dir != 0) {
            global_valve_value.total_ticks += dir;            
            QEvt_ctor(&amp;evt.super, VALVE_UPDATE_SIG);
            evt.evtType = VALVE_VALUE;
            QACTIVE_PUBLISH(&amp;evt.super, &amp;me-&gt;super);
        } else {
            // 处理错误（如复位状态）
        }
    } 
    last_state = new_state;
}
</action>
      <tran_glyph conn="28,42,3,-1,11">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="28,34,14,10">
      <entry box="0,3,6,2"/>
      <exit box="0,5,4,2"/>
     </state_glyph>
    </state>
    <state_diagram size="147,84"/>
   </statechart>
  </class>
  <class name="ValveHandler" superclass="qpc::QActive">
   <documentation>handle all internal action on the board;
include:
- flash;
- lcd;
- led;
- wireless;</documentation>
   <attribute name="inst" type="ValveHandler" visibility="0x00" properties="0x01"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="exitEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="persistEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>QActive_subscribe(&amp;me-&gt;super, LOCK_SIG);
QActive_subscribe(&amp;me-&gt;super, UNLOCK_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_UPDATE_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_REFACTORY_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_CONFIG_WRITE_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_CONFIG_READ_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_TUNNING_START_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_TUNNING_END_SIG);

//get valve data from flash
ValveValStore* _valve_store = (ValveValStore*)DATA_ADDR_FLASH;
if (_valve_store-&gt;flag == FLAG_VAILD) {
    memcpy(&amp;global_valve_store, (void*)DATA_ADDR_FLASH, sizeof(ValveValStore));
    printf(&quot;Load valve value from flash.\r\n&quot;);
}
if (global_valve_value-&gt;total_ticks &gt;= global_config.tick) {
    lcd_set_char(LCD_CHAR_OPEN_CHINESE, true);
    lcd_set_char(LCD_CHAR_OPEN_ARROW, true);
    lcd_set_char(LCD_CHAR_CLOSE_CHINESE, false);
    lcd_set_char(LCD_CHAR_CLOSE_ARROW, false);
} else if (global_valve_value-&gt;total_ticks &lt;= 0) {
    lcd_set_char(LCD_CHAR_CLOSE_CHINESE, true);
    lcd_set_char(LCD_CHAR_CLOSE_ARROW, true);
    lcd_set_char(LCD_CHAR_OPEN_CHINESE, false);
    lcd_set_char(LCD_CHAR_OPEN_ARROW, false);
}

//get valve config from spi flash
sFLASH_Init();
cmd_config_t _read_config = {0};
sFLASH_ReadBuffer((uint8_t*)&amp;_read_config, CONF_ADDR_EXFLASH, sizeof(cmd_config_t));
if (_read_config.flag == FLAG_VAILD) {
    memcpy(&amp;global_config, &amp;_read_config, sizeof(cmd_config_t));
    printf(&quot;Config read from flash and applied.\r\n&quot;);
} else {
    printf(&quot;Flash config is invaild, using default config.\r\n&quot;);
}
sFLASH_DeInit();
#ifdef USE_MODBUS
eMBInit(MB_RTU, 0x01, 1, 9600, MB_PAR_NONE);
eMBEnable();
QTimeEvt_armX(&amp;me-&gt;timeEvt, MS_TO_TICK(1), MS_TO_TICK(1));
#endif</action>
     <initial_glyph conn="18,12,5,1,62,7,-3">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Idle">
     <entry>Sleep_release(HANDLER_BIT);</entry>
     <exit>Sleep_request(HANDLER_BIT);</exit>
     <tran trig="UNLOCK" target="../3">
      <action>QF_CRIT_ENTRY();
if (global_valve_value-&gt;total_ticks &gt;= global_config.tick) {
    global_valve_value-&gt;total_ticks = global_config.tick;
} else if (global_valve_value-&gt;total_ticks &lt;= 0) {
    global_valve_value-&gt;total_ticks = 0;
}
last_total_ticks = global_valve_value-&gt;total_ticks;
sFLASH_Init();
QF_CRIT_EXIT();
QEvt_ctor(&amp;self_evt, VALVE_UPDATE_SIG);
QACTIVE_POST(AO_ValveHandler, &amp;self_evt, 0U);
QTimeEvt_disarm(&amp;me-&gt;exitEvt);</action>
      <tran_glyph conn="77,30,1,1,-6">
       <action box="-8,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_DAILY">
      <action brief="read flash and publish the event with ValveVal"/>
      <tran_glyph conn="18,24,3,-1,20">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TIMEOUT">
      <action>#ifdef USE_MODBUS
eMBPoll(); 
#endif</action>
      <tran_glyph conn="18,26,3,-1,20">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state name="Handle">
      <tran trig="LOCK">
       <action>QTimeEvt_rearm(&amp;me-&gt;exitEvt, MS_TO_TICK(500));</action>
       <tran_glyph conn="24,52,3,-1,14">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_UPDATE">
       <action brief="handle data write flash action and lcd refresh">ValveVal const *val = global_valve_value;
QF_CRIT_ENTRY();
if (val-&gt;total_ticks &gt;= global_config.tick) {
    lcd_set_char(LCD_CHAR_OPEN_CHINESE, true);
    lcd_set_char(LCD_CHAR_OPEN_ARROW, true);
    lcd_set_char(LCD_CHAR_CLOSE_CHINESE, false);
    lcd_set_char(LCD_CHAR_CLOSE_ARROW, false);
} else if (val-&gt;total_ticks &lt;= 0) {
    lcd_set_char(LCD_CHAR_CLOSE_CHINESE, true);
    lcd_set_char(LCD_CHAR_CLOSE_ARROW, true);
    lcd_set_char(LCD_CHAR_OPEN_CHINESE, false);
    lcd_set_char(LCD_CHAR_OPEN_ARROW, false);
}

#ifdef USE_MODBUS
extern UCHAR ucSCoilBuf[S_COIL_NCOILS / 8];
if (val-&gt;total_ticks &gt;= global_config.tick) {
    ucSCoilBuf[0] |= (1&lt;&lt;0);
} else if (val-&gt;total_ticks &lt;= 0) {
    ucSCoilBuf[0] &amp;= ~(1&lt;&lt;0);
}
#endif
QF_CRIT_EXIT();
QTimeEvt_rearm(&amp;me-&gt;persistEvt, MS_TO_TICK(500));

if (update_handle != NULL) {
    update_handle(val);
}</action>
       <tran_glyph conn="24,36,3,-1,14">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_CONFIG_WRITE">
       <action brief="handle config write flash action;if error happend, start timer for error blinky">ValveEvt const *ve = (ValveEvt const *)e;
memcpy(&amp;global_config, ve-&gt;msg, sizeof(cmd_config_t));
QF_CRIT_ENTRY();
sFLASH_EraseSector(CONF_ADDR_EXFLASH);
sFLASH_WriteBuffer((uint8_t*)&amp;global_config, CONF_ADDR_EXFLASH, sizeof(cmd_config_t));
QF_CRIT_EXIT();
printf(&quot;Config written to flash.\r\n&quot;);</action>
       <tran_glyph conn="24,42,3,-1,14">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_CONFIG_READ">
       <action>ValveEvt const* ve = (ValveEvt const*)e;
if (ve-&gt;handle != NULL) {
    ve-&gt;handle(&amp;global_config);
}</action>
       <tran_glyph conn="24,44,3,-1,14">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_EXIT" target="../..">
       <action>QF_CRIT_ENTRY();
printf(&quot;write flash\r\n&quot;);
uint32_t *p = (uint32_t *)&amp;global_valve_store;
size_t len = sizeof(ValveValStore) / sizeof(uint32_t);
flash_erase_page(DATA_ADDR_FLASH);
for (size_t i = 0; i &lt; len; ++i) {
    flash_program_word(DATA_ADDR_FLASH + i * 4, p[i]);
}
sFLASH_DeInit();
use_flash_data = true;
QF_CRIT_EXIT();</action>
       <tran_glyph conn="24,30,3,3,-6">
        <action box="-9,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_INFO_READ">
       <action>ValveEvt const* ve = (ValveEvt const*)e;
if (ve-&gt;handle != NULL &amp;&amp; ve-&gt;msg != NULL) {
    int is_enable = (intptr_t)ve-&gt;msg;
    if (is_enable) {
        update_handle = ve-&gt;handle;
        QEvt_ctor(&amp;self_evt, VALVE_UPDATE_SIG);
        QACTIVE_POST(AO_ValveHandler, &amp;self_evt, 0U);
    }else{
        update_handle = NULL;
    }
}</action>
       <tran_glyph conn="24,46,3,-1,14">
        <action box="0,-2,17,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_TUNNING_START" target="../9">
       <action>QF_CRIT_ENTRY();
global_valve_value-&gt;total_ticks = 0;
lcd_set_char(LCD_CHAR_CLOSE_CHINESE, true);
lcd_set_char(LCD_CHAR_CLOSE_ARROW, true);
lcd_set_char(LCD_CHAR_OPEN_CHINESE, true);
lcd_set_char(LCD_CHAR_OPEN_ARROW, true);
QF_CRIT_EXIT();
printf(&quot;calibration Start\r\n&quot;);</action>
       <tran_glyph conn="24,48,3,3,22">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_PERSIST">
       <action>if (global_valve_value-&gt;total_ticks != last_total_ticks) {
    uint32_t *p = (uint32_t *)&amp;global_valve_store;
    size_t len = sizeof(ValveValStore) / sizeof(uint32_t);
    flash_erase_page(DATA_ADDR_FLASH);
    for (size_t i = 0; i &lt; len; ++i) {
        flash_program_word(DATA_ADDR_FLASH + i * 4, p[i]);
    }
    last_total_ticks = global_valve_value-&gt;total_ticks;
    use_flash_data = true;
}</action>
       <tran_glyph conn="24,38,3,-1,14">
        <action box="0,-2,14,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_REFACTORY">
       <action>QF_CRIT_ENTRY();
flash_erase_page(DATA_ADDR_FLASH);
sFLASH_EraseSector(CONF_ADDR_EXFLASH);
QF_CRIT_EXIT();</action>
       <tran_glyph conn="24,40,3,-1,14">
        <action box="0,-2,15,2"/>
       </tran_glyph>
      </tran>
      <state name="Tuning">
       <tran trig="VALVE_TUNNING_END" target="../..">
        <action>QF_CRIT_ENTRY();
global_config.tick = global_valve_value-&gt;total_ticks;
sFLASH_EraseSector(CONF_ADDR_EXFLASH);
sFLASH_WriteBuffer((uint8_t*)&amp;global_config, CONF_ADDR_EXFLASH, sizeof(cmd_config_t));
QF_CRIT_EXIT();
QEvt_ctor(&amp;self_evt, VALVE_UPDATE_SIG);
QACTIVE_POST(AO_ValveHandler, &amp;self_evt, 0U);
printf(&quot;calibration Done\r\n&quot;);</action>
        <tran_glyph conn="46,50,3,3,-22">
         <action box="-17,-2,19,2"/>
        </tran_glyph>
       </tran>
       <tran trig="VALVE_UPDATE">
        <action>ValveVal const *val = global_valve_value;
if (update_handle != NULL) {
    update_handle(val);
}</action>
        <tran_glyph conn="46,40,3,-1,15">
         <action box="0,-2,14,2"/>
        </tran_glyph>
       </tran>
       <state_glyph node="46,33,21,19"/>
      </state>
      <state_glyph node="24,27,47,27"/>
     </state>
     <state_glyph node="18,16,59,40">
      <entry box="0,3,6,2"/>
      <exit box="0,5,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="141,83"/>
   </statechart>
  </class>
  <class name="ValveConf" superclass="qpc::QActive">
   <documentation>Abstract a interface between user and board,inclue:
- Daily actoin trigger by RTC Alarm;
- Configuration parse from serial, trigger by uart, if there's a necessary to write flash,publish event to ValveHandler;</documentation>
   <attribute name="inst" type="ValveConf" visibility="0x00" properties="0x01"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../2">
     <action>QActive_subscribe(&amp;me-&gt;super, LOCK_SIG);
QActive_subscribe(&amp;me-&gt;super, UNLOCK_SIG);</action>
     <initial_glyph conn="20,16,5,1,20,7,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Active">
     <entry>cmd_init();</entry>
     <exit>cmd_deinit();</exit>
     <tran trig="TIMEOUT">
      <action>static int count = 10;
//blinky, toggle led
count--;
if(!count){
    QTimeEvt_disarm(&amp;me-&gt;timeEvt);
    count = 0;
}</action>
      <tran_glyph conn="20,42,3,-1,13">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="LOCK" target="../../2">
      <tran_glyph conn="20,40,3,3,-2,-14,2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_CMD_PARSE">
      <action>ValveEvt* const evt = (ValveEvt*)e;
if (evt-&gt;evtType == VALVE_CMD) {
    cmd_execute((char*)evt-&gt;msg);
}</action>
      <tran_glyph conn="20,44,3,-1,13">
       <action box="0,-2,17,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="20,34,18,14">
      <entry box="0,3,6,2"/>
      <exit box="0,5,6,2"/>
     </state_glyph>
    </state>
    <state name="Wait">
     <entry>Sleep_release(CONFIG_BIT);</entry>
     <exit>Sleep_request(CONFIG_BIT);</exit>
     <tran trig="UNLOCK" target="../../1">
      <tran_glyph conn="38,26,1,1,2,14,-2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="20,20,18,10">
      <entry box="0,3,6,2"/>
      <exit box="0,5,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="135,88"/>
   </statechart>
  </class>
  <attribute name="AO_ValveCounter" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;ValveCounter_inst.super;</code>
  </attribute>
  <operation name="ValveCounter_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveCounter * const me = &amp;ValveCounter_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveCounter_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, &amp;me-&gt;super, TIMEOUT_SIG, 0U);</code>
  </operation>
  <attribute name="AO_ValveHandler" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;ValveHandler_inst.super;</code>
  </attribute>
  <operation name="ValveHandler_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveHandler * const me = &amp;ValveHandler_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveHandler_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, &amp;me-&gt;super, TIMEOUT_SIG, 0U);
QTimeEvt_ctorX(&amp;me-&gt;persistEvt, &amp;me-&gt;super, VALVE_PERSIST_SIG, 0U);
QTimeEvt_ctorX(&amp;me-&gt;exitEvt, &amp;me-&gt;super, VALVE_EXIT_SIG, 0U);</code>
  </operation>
  <attribute name="AO_ValveConf" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;ValveConf_inst.super;</code>
  </attribute>
  <operation name="ValveConf_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveConf * const me = &amp;ValveConf_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveConf_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, &amp;me-&gt;super, TIMEOUT_SIG, 0U);</code>
  </operation>
 </package>
 <directory name=".">
  <file name="valve_counter.c">
   <text>#include &quot;qpc.h&quot; 
#include &quot;bsp.h&quot;
#include &quot;cmd.h&quot;
#include &quot;valve.h&quot;

// ======================== 方向映射表 ========================
typedef struct {
    uint8_t from; // 起始状态
    uint8_t to;   // 目标状态
    int8_t  dir;  // 方向 (+1正转, -1反转)
} TransitionRule;

extern cmd_config_t global_config;
extern ValveVal     global_valve_value;

static ValveEvt evt;

$declare ${AOs::ValveCounter}

// 方向映射表(64x64, 未定义部分置0)
static const int8_t rules[64][64] = {
    // 单触发+1
    [0x01][0x02] = 1,
    [0x02][0x04] = 1,
    [0x04][0x08] = 1,
    [0x08][0x10] = 1,
    [0x10][0x20] = 1,
    [0x20][0x01] = 1, // 环形连接
    // 单触发-1
    [0x02][0x01] = -1,
    [0x04][0x02] = -1,
    [0x08][0x04] = -1,
    [0x10][0x08] = -1,
    [0x20][0x10] = -1,
    [0x01][0x20] = -1, // 环形连接
    // 单触发+2
    [0x01][0x04] = 2,
    [0x02][0x08] = 2,
    [0x04][0x10] = 2,
    [0x08][0x20] = 2,
    [0x10][0x01] = 2,
    [0x20][0x02] = 2, // 环形连接
    // 单触发-2
    [0x04][0x01] = -2,
    [0x08][0x02] = -2,
    [0x10][0x04] = -2,
    [0x20][0x08] = -2,
    [0x01][0x10] = -2,
    [0x02][0x20] = -2, // 环形连接
    // 双触发+1(单--&gt;双)
    [0x01][0x03] = 1,
    [0x02][0x06] = 1,
    [0x04][0x0C] = 1,
    [0x08][0x18] = 1,
    [0x10][0x30] = 1,
    [0x20][0x21] = 1, // 环形连接
    // 双触发-1(单--&gt;双)
    [0x03][0x01] = -1,
    [0x06][0x02] = -1,
    [0x0C][0x04] = -1,
    [0x18][0x08] = -1,
    [0x30][0x10] = -1,
    [0x21][0x20] = -1, // 环形连接
    // 双触发+2(单--&gt;双)
    [0x01][0x06] = 2,
    [0x02][0x0C] = 2,
    [0x04][0x18] = 2,
    [0x08][0x30] = 2,
    [0x10][0x21] = 2,
    [0x20][0x03] = 2, // 环形连接
    // 双触发-2(单--&gt;双)
    [0x06][0x01] = -2,
    [0x0C][0x02] = -2,
    [0x18][0x04] = -2,
    [0x30][0x08] = -2,
    [0x21][0x10] = -2,
    [0x03][0x20] = -2, // 环形连接
    // 双触发+3(单--&gt;双)
    [0x01][0x0C] = 3,
    [0x02][0x18] = 3,
    [0x04][0x30] = 3,
    [0x08][0x21] = 3,
    [0x10][0x03] = 3,
    [0x20][0x06] = 3, // 环形连接
    // 双触发-3(单--&gt;双)
    [0x0C][0x01] = -3,
    [0x18][0x02] = -3,
    [0x30][0x04] = -3,
    [0x21][0x08] = -3,
    [0x03][0x10] = -3,
    [0x06][0x20] = -3, // 环形连接
};

// ======================== 核心逻辑 ========================
// 读取传感器状态（6-bit编码）
static inline uint8_t read_sensor_state(void)
{
    return (uint8_t)(GPIOC-&gt;PID &amp; 0xf | ((GPIOA-&gt;PID &amp; 0x6) &lt;&lt; 4));
}

// 检查是否为合法状态（单或双传感器触发）
static bool is_valid_state(uint8_t* state)
{
    switch (*state) {
        // 单传感器触发
        case 0x01:
        case 0x02:
        case 0x04:
        case 0x08:
        case 0x10:
        case 0x20:
        // 双传感器触发（相邻两个）
        case 0x03:
        case 0x06:
        case 0x0C:
        case 0x18:
        case 0x30:
        case 0x21:
            return true;
        default:
            return false; // 非法状态（如三个传感器同时触发）,无传感器触发
    }
}

// 检查方向（允许1-bit误差）
static int8_t check_direction(uint8_t* old, uint8_t* new)
{
    return global_config.dir * rules[*old][*new]; // 直接访问映射表
}

$define ${AOs::AO_ValveCounter}
$define ${AOs::ValveCounter_ctor}
$define ${AOs::ValveCounter}</text>
