<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.1" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="Shared" stereotype="0x00">
  <attribute name="AppSignals" type="enum" visibility="0x04" properties="0x00">
   <code>{
    VALVE_LOCK_SIG = Q_USER_SIG,
    VALVE_UNLOCK_SIG,
    VALVE_REBOOT_SIG,
    VALVE_DAILY_SIG,
    VALVE_UPDATE_SIG,
    VALVE_EXIT_SIG,
    VALVE_CMD_PREPARE_SIG,
    VALVE_CMD_PARSE_SIG,
    VALVE_REFACTORY_SIG,
    VALVE_CONFIG_WRITE_SIG,
    VALVE_CONFIG_READ_SIG,
    VALVE_INFO_READ_SIG,
    VALVE_PERSIST_SIG,
    VALVE_PERSIST_START_SIG,
    VALVE_PERSIST_PROCESS_SIG,
    VALVE_TRANSFER_INIT_SIG,
    VALVE_TRANSFER_POLL_SIG,
    MAX_PUB_SIG,

    TIMEOUT_SIG,
    MAX_SIG,
};</code>
  </attribute>
  <attribute name="Sleep_bits" type="volatile uint32_t" visibility="0x00" properties="0x00"/>
  <attribute name="Sleep_slotbit" type="enum" visibility="0x04" properties="0x00">
   <code>{
    LOCK_BIT     = 1 &lt;&lt; 0,
    HANDLER_BIT  = 1 &lt;&lt; 1,
    CONFIG_BIT   = 1 &lt;&lt; 2,
    PERSIST_BIT  = 1 &lt;&lt; 3,
    TRANSFER_BIT = 1 &lt;&lt; 4,
};</code>
  </attribute>
  <operation name="Sleep_request" type="void" visibility="0x00" properties="0x02">
   <parameter name="bit" type="uint32_t"/>
   <code>Sleep_bits |= bit;</code>
  </operation>
  <operation name="Sleep_release" type="void" visibility="0x00" properties="0x02">
   <parameter name="bit" type="uint32_t"/>
   <code>Sleep_bits &amp;= ~bit;</code>
  </operation>
  <attribute name="ValveEvtType" type="enum" visibility="0x04" properties="0x00">
   <code>{
    VALVE_VALUE,
    VALVE_CMD,
};</code>
  </attribute>
  <attribute name="(*EvtHandle)(void*)" type="typedef void " visibility="0x04" properties="0x00"/>
  <class name="ValveEvt" superclass="qpc::QEvt">
   <attribute name="msg" type="void *" visibility="0x00" properties="0x00"/>
   <attribute name="handle" type="EvtHandle" visibility="0x00" properties="0x00"/>
   <attribute name="evtType" type="enum ValveEvtType" visibility="0x00" properties="0x00"/>
  </class>
  <class name="ValvePersistRequest">
   <attribute name="word_len" type="uint32_t" visibility="0x00" properties="0x00"/>
   <attribute name="data_ptr" type="uint32_t" visibility="0x00" properties="0x00"/>
   <attribute name="write_ptr" type="uint32_t" visibility="0x00" properties="0x00"/>
  </class>
 </package>
 <package name="AOs" stereotype="0x02">
  <class name="ValveHandler" superclass="qpc::QMActive">
   <documentation>handle all internal action on the board;
include:
- flash;
- lcd;
- led;
- wireless;</documentation>
   <attribute name="inst" type="ValveHandler" visibility="0x00" properties="0x01"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="exitEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="persistEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>QActive_subscribe((QActive*)me, VALVE_LOCK_SIG);
QActive_subscribe((QActive*)me, VALVE_UNLOCK_SIG);
QActive_subscribe((QActive*)me, VALVE_REBOOT_SIG);
QActive_subscribe((QActive*)me, VALVE_REFACTORY_SIG);
QActive_subscribe((QActive*)me, VALVE_CONFIG_WRITE_SIG);
QActive_subscribe((QActive*)me, VALVE_CONFIG_READ_SIG);</action>
     <initial_glyph conn="18,12,5,1,62,7,-3">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Idle">
     <tran trig="VALVE_UNLOCK" target="../3">
      <action>Sleep_request(HANDLER_BIT);

QF_CRIT_ENTRY();
sFLASH_Init();
QF_CRIT_EXIT();
QEvt_ctor(&amp;evt.super, VALVE_UPDATE_SIG);
QACTIVE_POST(AO_ValveHandler, &amp;evt.super, 0U);
QTimeEvt_disarm(&amp;me-&gt;exitEvt);</action>
      <tran_glyph conn="77,30,1,1,-6">
       <action box="-8,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TIMEOUT">
      <tran_glyph conn="18,26,3,-1,20">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_DAILY">
      <tran_glyph conn="18,22,3,-1,20">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state name="Handle">
      <tran trig="VALVE_LOCK">
       <action>QTimeEvt_rearm(&amp;me-&gt;exitEvt, MS_TO_TICK(2000));</action>
       <tran_glyph conn="24,52,3,-1,14">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_UPDATE">
       <action brief="handle data write flash action and lcd refresh">QTimeEvt_rearm(&amp;me-&gt;persistEvt, MS_TO_TICK(2000));</action>
       <tran_glyph conn="24,34,3,-1,14">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_CONFIG_WRITE">
       <action brief="handle config write flash action;if error happend, start timer for error blinky">ValveEvt const *ve = (ValveEvt const *)e;
if (ve-&gt;evtType == VALVE_CMD){
    memcpy(&amp;global_config, ve-&gt;msg, sizeof(cmd_config_t));
    QF_CRIT_ENTRY();
    sFLASH_EraseSector(CONF_ADDR_EXFLASH);
    sFLASH_WriteBuffer((uint8_t*)&amp;global_config, CONF_ADDR_EXFLASH, sizeof(cmd_config_t));
    QF_CRIT_EXIT();
    APP_LOG_INFO(&quot;Config written to flash&quot;);
}</action>
       <tran_glyph conn="24,42,3,-1,14">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_CONFIG_READ">
       <action>ValveEvt const* ve = (ValveEvt const*)e;
if (ve-&gt;handle != NULL &amp;&amp; ve-&gt;evtType == VALVE_CMD) {
    ve-&gt;handle(&amp;global_config);
}</action>
       <tran_glyph conn="24,44,3,-1,14">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_EXIT" target="../..">
       <action>QF_CRIT_ENTRY();
sFLASH_DeInit();
QF_CRIT_EXIT();
Sleep_release(HANDLER_BIT);</action>
       <tran_glyph conn="24,30,3,3,-6">
        <action box="-9,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_INFO_READ">
       <action>ValveEvt const* ve = (ValveEvt const*)e;
if (ve-&gt;handle != NULL &amp;&amp; ve-&gt;msg != NULL &amp;&amp; ve-&gt;evtType == VALVE_CMD) {
    int is_enable = (intptr_t)ve-&gt;msg;
    if (is_enable) {
        update_handle = ve-&gt;handle;
        QEvt_ctor(&amp;evt.super, VALVE_UPDATE_SIG);
        QACTIVE_POST(AO_ValveHandler, &amp;evt.super, 0U);
    }else{
        update_handle = NULL;
    }
}</action>
       <tran_glyph conn="24,46,3,-1,14">
        <action box="0,-2,17,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_PERSIST">
       <action>if (global_valve_status != last_valve_status) {
#ifdef USE_LORAWAN
    at_lorawan_event_post();
#endif
    last_valve_status = global_valve_status;
}</action>
       <tran_glyph conn="24,36,3,-1,14">
        <action box="0,-2,14,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_REFACTORY">
       <action>QF_CRIT_ENTRY();
flash_erase_page(DATA_ADDR_FLASH);
sFLASH_EraseSector(CONF_ADDR_EXFLASH);
QF_CRIT_EXIT();</action>
       <tran_glyph conn="24,40,3,-1,14">
        <action box="0,-2,15,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_REBOOT">
       <action>NVIC_SystemReset();</action>
       <tran_glyph conn="24,38,3,-1,14">
        <action box="0,-2,15,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="24,27,47,27"/>
     </state>
     <state_glyph node="18,16,59,40"/>
    </state>
    <state_diagram size="88,83"/>
   </statechart>
  </class>
  <class name="ValveConf" superclass="qpc::QMActive">
   <documentation>Abstract a interface between user and board,inclue:
- Daily actoin trigger by RTC Alarm;
- Configuration parse from serial, trigger by uart, if there's a necessary to write flash,publish event to ValveHandler;</documentation>
   <attribute name="inst" type="ValveConf" visibility="0x00" properties="0x01"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../2">
     <action>QActive_subscribe((QActive*)me, VALVE_LOCK_SIG);
QActive_subscribe((QActive*)me, VALVE_UNLOCK_SIG);</action>
     <initial_glyph conn="20,16,5,1,20,6,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Active">
     <entry>cmd_init();</entry>
     <exit>cmd_deinit();</exit>
     <tran trig="TIMEOUT">
      <action>static int count = 10;
//blinky, toggle led
count--;
if(!count){
    QTimeEvt_disarm(&amp;me-&gt;timeEvt);
    count = 0;
}</action>
      <tran_glyph conn="20,42,3,-1,13">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_LOCK" target="../../2">
      <action>Sleep_release(CONFIG_BIT);</action>
      <tran_glyph conn="20,40,3,3,-2,-15,2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_CMD_PARSE">
      <action>ValveEvt* const evt = (ValveEvt*)e;
if (evt-&gt;evtType == VALVE_CMD) {
    cmd_execute((char*)evt-&gt;msg);
}</action>
      <tran_glyph conn="20,44,3,-1,13">
       <action box="0,-2,17,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_CMD_PREPARE">
      <action>cmd_set_name();</action>
      <tran_glyph conn="20,46,3,-1,13">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="20,34,18,19">
      <entry box="0,3,6,2"/>
      <exit box="0,5,6,2"/>
     </state_glyph>
    </state>
    <state name="Wait">
     <tran trig="VALVE_UNLOCK" target="../../1">
      <action>Sleep_request(CONFIG_BIT);</action>
      <tran_glyph conn="38,25,1,1,2,15,-2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="20,19,18,10"/>
    </state>
    <state_diagram size="61,88"/>
   </statechart>
  </class>
  <class name="ValvePersist" superclass="qpc::QMActive">
   <attribute name="processEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="inst" type="ValvePersist" visibility="0x00" properties="0x01"/>
   <attribute name="request" type="ValvePersistRequest" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <initial_glyph conn="31,18,5,1,21,6,-2">
      <action box="1,-4,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Idle">
     <entry>Sleep_release(PERSIST_BIT);</entry>
     <exit>Sleep_request(PERSIST_BIT);</exit>
     <tran trig="VALVE_PERSIST_START" target="../../3">
      <action>ValveEvt const* ve = (ValveEvt const*)e;
if (ve-&gt;evtType == VALVE_VALUE) {
    memcpy(&amp;me-&gt;request, ve-&gt;msg, sizeof(ValvePersistRequest));
    write_ptr = me-&gt;request.write_ptr;
    QTimeEvt_armX(&amp;me-&gt;processEvt, MS_TO_TICK(1), MS_TO_TICK(1));
}</action>
      <tran_glyph conn="36,28,3,1,16,10,-2">
       <action box="0,-2,19,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="36,20,14,12">
      <entry box="0,3,6,2"/>
      <exit box="0,5,6,2"/>
     </state_glyph>
    </state>
    <state name="Complete">
     <entry>me-&gt;request.word_len--;
me-&gt;request.data_ptr  += 4;
me-&gt;request.write_ptr += 4;</entry>
     <tran trig="VALVE_PERSIST_PROCESS">
      <choice target="../../../1">
       <guard brief="remain == 0">me-&gt;request.word_len == 0</guard>
       <action>QTimeEvt_disarm(&amp;me-&gt;processEvt);</action>
       <choice_glyph conn="45,70,4,3,6,-16,-50,7">
        <action box="-13,7,13,2"/>
       </choice_glyph>
      </choice>
      <choice>
       <guard brief="remain &gt; 0">me-&gt;request.word_len &gt; 0</guard>
       <choice target="../../../../3">
        <guard brief="need erase">me-&gt;request.write_ptr - write_ptr == PAGE_LEN</guard>
        <action>write_ptr += PAGE_LEN;</action>
        <choice_glyph conn="56,70,5,1,4,-30,-10">
         <action box="5,-15,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../../4">
        <guard brief="directly write">me-&gt;request.write_ptr - write_ptr &lt; PAGE_LEN</guard>
        <choice_glyph conn="56,70,4,1,-16,-6">
         <action box="-5,-9,10,2"/>
        </choice_glyph>
       </choice>
       <choice_glyph conn="45,70,5,-1,11">
        <action box="1,0,13,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="35,70,3,-1,10">
       <action box="0,-2,22,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="35,62,14,12">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="Prepare">
     <entry brief="perpare page for writing, done earse">flash_fsm_init(&amp;flash_fsm);
flash_request.type    = FLASH_OP_ERASE_PAGE;
flash_request.address = write_ptr;
flash_request.data    = 0;
flash_fsm_start(&amp;flash_fsm, &amp;flash_request, NULL, NULL);</entry>
     <tran trig="VALVE_PERSIST_PROCESS">
      <action>flash_fsm_process(&amp;flash_fsm);</action>
      <choice target="../../../4">
       <guard brief="success">flash_fsm_get_result(&amp;flash_fsm) == FLASH_RESULT_SUCCESS</guard>
       <choice_glyph conn="46,42,5,1,6,10,-2">
        <action box="1,0,10,2"/>
       </choice_glyph>
      </choice>
      <choice target="../../../1">
       <guard brief="fail">(flash_fsm_get_result(&amp;flash_fsm) != FLASH_RESULT_SUCCESS) &amp;&amp; (flash_fsm_get_result(&amp;flash_fsm) != FLASH_RESULT_PENDING)</guard>
       <choice_glyph conn="46,42,4,3,2,-12,-14,2">
        <action box="-8,2,9,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="36,42,3,-1,10">
       <action box="0,-2,22,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="36,34,14,12">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="Handle">
     <entry>flash_fsm_init(&amp;flash_fsm);
flash_request.type    = FLASH_OP_PROGRAM_WORD;
flash_request.address = me-&gt;request.write_ptr;
flash_request.data    = *(uint32_t*)me-&gt;request.data_ptr;
flash_fsm_start(&amp;flash_fsm, &amp;flash_request, NULL, NULL);</entry>
     <tran trig="VALVE_PERSIST_PROCESS">
      <action>flash_fsm_process(&amp;flash_fsm);</action>
      <choice target="../../../2">
       <guard brief="success">flash_fsm_get_result(&amp;flash_fsm) == FLASH_RESULT_SUCCESS</guard>
       <choice_glyph conn="46,56,5,1,6,10,-3">
        <action box="1,0,10,2"/>
       </choice_glyph>
      </choice>
      <choice target="../../../1">
       <guard brief="fail">(flash_fsm_get_result(&amp;flash_fsm) != FLASH_RESULT_SUCCESS) &amp;&amp; (flash_fsm_get_result(&amp;flash_fsm) != FLASH_RESULT_PENDING)</guard>
       <choice_glyph conn="46,56,4,3,2,-14,-30,4">
        <action box="-8,2,10,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="36,56,3,-1,10">
       <action box="0,-2,22,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="36,48,14,12">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="110,89"/>
   </statechart>
  </class>
  <class name="ValveTransfer" superclass="qpc::QMActive">
   <attribute name="inst" type="ValveTransfer" visibility="0x00" properties="0x01"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="pollEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="tick" type="uint32_t" visibility="0x00" properties="0x00"/>
   <attribute name="isActive" type="bool" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>me-&gt;isActive = false;
me-&gt;tick     = 0;
QTimeEvt_armX(&amp;me-&gt;pollEvt, MS_TO_TICK(1), MS_TO_TICK(1));
#ifdef USE_MODBUS
eMBInit(MB_RTU, 0x01, 1, 9600, MB_PAR_NONE);
eMBEnable();
#endif</action>
     <initial_glyph conn="22,14,5,1,28,8,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Idle">
     <tran trig="VALVE_TRANSFER_INIT">
      <action>if (!me-&gt;isActive) {
    QTimeEvt_armX(&amp;me-&gt;timeEvt, MS_TO_TICK(5), MS_TO_TICK(5));
    Sleep_request(TRANSFER_BIT);
    me-&gt;isActive = true;
    me-&gt;tick     = 0;
#ifdef USE_LORAWAN
    at_lorawan_init();
#endif
}</action>
      <tran_glyph conn="22,22,3,-1,14">
       <action box="0,-2,19,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TIMEOUT">
      <choice target="../../3">
       <guard brief="is_ready">at_lorawan_is_ready() == true</guard>
       <action>#ifdef USE_LORAWAN
me-&gt;tick = 0;
at_lorawan_config_prepare();
#endif</action>
       <choice_glyph conn="36,28,5,1,8,6,-2">
        <action box="1,0,10,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="22,28,3,-1,14">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_TRANSFER_POLL">
      <action>me-&gt;tick++;
#ifdef USE_MODBUS
eMBPoll(); 
#endif</action>
      <tran_glyph conn="22,24,3,-1,14">
       <action box="0,-2,20,2"/>
      </tran_glyph>
     </tran>
     <state name="Prepare">
      <tran trig="TIMEOUT">
       <action>result = at_lorawan_poll(me-&gt;tick);</action>
       <choice target="../../../4">
        <guard brief="success">result == AT_PROCESS_COMPLETE</guard>
        <action>char payload[64] = {0};
snprintf(payload,
         sizeof(payload),
         &quot;%02x&quot;,
         global_valve_status);
at_lorawan_send_prepare(payload);</action>
        <choice_glyph conn="36,38,5,1,8,10,-2">
         <action box="1,0,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../..">
        <guard brief="fail">result == AT_PROCESS_ERROR</guard>
        <action>QTimeEvt_disarm(&amp;me-&gt;timeEvt);
Sleep_release(TRANSFER_BIT);
me-&gt;isActive = false;
at_lorawan_deinit();
APP_LOG_ERROR(&quot;Error at transfer prepare&quot;);</action>
        <choice_glyph conn="36,38,4,3,4,-14">
         <action box="-5,2,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../..">
        <guard brief="else"/>
        <choice_glyph conn="36,38,4,3,-4,-10">
         <action box="0,-4,10,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="26,38,3,-1,10">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="26,30,16,10"/>
     </state>
     <state name="Transfer">
      <tran trig="TIMEOUT">
       <action>result = at_lorawan_poll(me-&gt;tick);</action>
       <choice target="../../..">
        <guard brief="fail">result == AT_PROCESS_ERROR</guard>
        <action>QTimeEvt_disarm(&amp;me-&gt;timeEvt);
Sleep_release(TRANSFER_BIT);
me-&gt;isActive = false;
at_lorawan_deinit();
APP_LOG_ERROR(&quot;Error at transfer operation&quot;);</action>
        <choice_glyph conn="36,52,4,3,4,-14">
         <action box="-5,4,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../..">
        <guard brief="success">result == AT_PROCESS_COMPLETE</guard>
        <action>QTimeEvt_disarm(&amp;me-&gt;timeEvt);
Sleep_release(TRANSFER_BIT);
me-&gt;isActive = false;
at_lorawan_deinit();</action>
        <choice_glyph conn="36,52,5,1,12">
         <action box="1,0,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../..">
        <guard brief="else"/>
        <choice_glyph conn="36,52,4,3,-4,-10">
         <action box="1,-4,10,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="26,52,3,-1,10">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="26,44,16,10"/>
     </state>
     <state_glyph node="22,16,26,45"/>
    </state>
    <state_diagram size="84,84"/>
   </statechart>
  </class>
  <operation name="ValveCounter_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveCounter * const me = &amp;ValveCounter_inst;
QMActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveCounter_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, (QActive*)me, TIMEOUT_SIG, 0U);</code>
  </operation>
