<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.1" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="Shared" stereotype="0x00">
  <attribute name="AppSignals" type="enum" visibility="0x04" properties="0x00">
   <code>{
    LOCK_ON_SIG = Q_USER_SIG,
    LOCK_OFF_SIG,
    VALVE_DAILY_SIG,
    VALVE_UPDATE_SIG,
    VALVE_CONFIG_PARSE_SIG,
    VALVE_CONFIG_WRITE_SIG,
    VALVE_CONFIG_READ_SIG,
    MAX_PUB_SIG,

    TIMEOUT_SIG,
    MAX_SIG,
};</code>
  </attribute>
  <attribute name="Sleep_bits" type="uint32_t" visibility="0x00" properties="0x00"/>
  <attribute name="Sleep_slotbit" type="enum" visibility="0x04" properties="0x00">
   <code>{
    LOCK_BIT    = 1 &lt;&lt; 0,
    COUNTER_BIT = 1 &lt;&lt; 1,
    HANDLER_BIT = 1 &lt;&lt; 2,
    CONFIG_BIT  = 1 &lt;&lt; 3,
};</code>
  </attribute>
  <operation name="Sleep_request" type="void" visibility="0x00" properties="0x02">
   <parameter name="bit" type="uint32_t"/>
   <code>Sleep_bits |= bit;</code>
  </operation>
  <operation name="Sleep_release" type="void" visibility="0x00" properties="0x02">
   <parameter name="bit" type="uint32_t"/>
   <code>Sleep_bits &amp;= ~bit;</code>
  </operation>
  <class name="ValveVal">
   <attribute name="total_ticks" type="int32_t" visibility="0x00" properties="0x00"/>
   <attribute name="rotations" type="int32_t" visibility="0x00" properties="0x00"/>
   <attribute name="position" type="int32_t" visibility="0x00" properties="0x00"/>
  </class>
  <class name="ValveConfig"/>
  <class name="ValveEvt" superclass="qpc::QEvt">
   <attribute name="msg" type="void *" visibility="0x00" properties="0x00"/>
   <attribute name="evtType" type="ValveEvtType" visibility="0x00" properties="0x00"/>
  </class>
  <attribute name="ValveEvtType" type="enum" visibility="0x04" properties="0x00">
   <code>{
    VALVE_VALUE,
    VALVE_CONFIG,
};</code>
  </attribute>
 </package>
 <package name="AOs" stereotype="0x02">
  <class name="ValveCounter" superclass="qpc::QActive">
   <documentation>Trigger by timeout, then collect hall sensor data and decode it. If there's a leagal update action,will publish event to ValveHandler</documentation>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="inst" type="ValveCounter" visibility="0x00" properties="0x01"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>QActive_subscribe(&amp;me-&gt;super, LOCK_ON_SIG);
QActive_subscribe(&amp;me-&gt;super, LOCK_OFF_SIG);</action>
     <initial_glyph conn="26,14,5,1,18,7,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Wait">
     <entry brief="set sleep bits 1">Sleep_request(COUNTER_BIT);</entry>
     <exit brief="set sleep bits 0">Sleep_release(COUNTER_BIT);</exit>
     <tran trig="LOCK_OFF" target="../../2">
      <tran_glyph conn="42,25,1,1,2,13,-2">
       <action box="2,0,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="28,17,14,10">
      <entry box="0,3,4,2"/>
      <exit box="0,5,4,2"/>
     </state_glyph>
    </state>
    <state name="Work">
     <entry brief="switch on hall sensors; start timer to handle sensor data;">hall_set_ctr(ENABLE);
QTimeEvt_armX(&amp;me-&gt;timeEvt, 1, 1);</entry>
     <exit brief="stop timer; switch off hall sensors;">QTimeEvt_disarm(&amp;me-&gt;timeEvt);
hall_set_ctr(DISABLE);</exit>
     <tran trig="LOCK_ON" target="../../1">
      <tran_glyph conn="28,38,3,3,-2,-13,2">
       <action box="-10,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TIMEOUT">
      <action>static uint8_t last_state = 0;
static ValveVal _val = {0};
static ValveEvt _ve  = {0};
uint8_t new_state    = read_sensor_state();

if (new_state != last_state &amp;&amp; is_valid_state(&amp;new_state)) {
    // 检查方向并更新旋转计数
    if (is_valid_state(&amp;last_state)) {
        int8_t dir = check_direction(&amp;last_state, &amp;new_state);
        if (dir != 0) {
            _val.total_ticks += dir;

            // 更新位置计数
            _val.position = (_val.total_ticks % TICKS_PER_ROTATION + TICKS_PER_ROTATION) % TICKS_PER_ROTATION;
            // 更新圈数
            _val.rotations = _val.total_ticks / TICKS_PER_ROTATION;
            
            QEvt const se  = QEVT_INITIALIZER(VALVE_UPDATE_SIG);
            _ve.super      = se;
            _ve.evtType    = VALVE_VALUE;
            _ve.msg        = &amp;_val;
            QACTIVE_PUBLISH(&amp;_ve.super, &amp;me-&gt;super);
        } else {
            // 处理错误（如复位状态）
        }
    } 
    last_state = new_state;        
}</action>
      <tran_glyph conn="28,42,3,-1,11">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="28,34,14,10">
      <entry box="0,3,6,2"/>
      <exit box="0,5,4,2"/>
     </state_glyph>
    </state>
    <state_diagram size="147,84"/>
   </statechart>
  </class>
  <class name="ValveHandler" superclass="qpc::QActive">
   <documentation>handle all internal action on the board;
include:
- flash;
- lcd;
- led;
- wireless;</documentation>
   <attribute name="inst" type="ValveHandler" visibility="0x00" properties="0x01"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>QActive_subscribe(&amp;me-&gt;super, LOCK_ON_SIG);
QActive_subscribe(&amp;me-&gt;super, LOCK_OFF_SIG);
QActive_subscribe(&amp;me-&gt;super, VALVE_UPDATE_SIG);</action>
     <initial_glyph conn="18,12,5,1,34,7,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Idle">
     <tran trig="LOCK_OFF" target="../2">
      <tran_glyph conn="50,34,1,1,-6">
       <action box="-8,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_DAILY">
      <action brief="read flash and publish the event with ValveVal"/>
      <tran_glyph conn="18,24,3,-1,20">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state name="Handle">
      <entry>Sleep_release(HANDLER_BIT);</entry>
      <exit>Sleep_request(HANDLER_BIT);</exit>
      <tran trig="LOCK_ON" target="../..">
       <tran_glyph conn="24,34,3,3,-6">
        <action box="-8,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_UPDATE">
       <action brief="handle data write flash action and lcd refresh">ValveEvt const *ve = (ValveEvt const *)e;
printf(&quot;Position: %d/6 (%.1f°), Rotations: %d, Total Ticks: %d\r\n&quot;,
       ve-&gt;value-&gt;position,
       (ve-&gt;value-&gt;position * 360.0f / TICKS_PER_ROTATION),
       ve-&gt;value-&gt;rotations,
       ve-&gt;value-&gt;total_ticks);</action>
       <tran_glyph conn="24,38,3,-1,14">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_CONFIG_WRITE">
       <action brief="handle config write flash action;if error happend, start timer for error blinky"/>
       <tran_glyph conn="24,40,3,-1,14">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="VALVE_CONFIG_READ">
       <tran_glyph conn="24,42,3,-1,14">
        <action box="0,-2,19,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="24,28,20,16">
       <entry box="0,3,6,2"/>
       <exit box="0,5,6,2"/>
      </state_glyph>
     </state>
     <state_glyph node="18,16,32,30"/>
    </state>
    <state_diagram size="141,83"/>
   </statechart>
  </class>
  <class name="ValveConf" superclass="qpc::QActive">
   <documentation>Abstract a interface between user and board,inclue:
- Daily actoin trigger by RTC Alarm;
- Configuration parse from serial, trigger by uart, if there's a necessary to write flash,publish event to ValveHandler;</documentation>
   <attribute name="inst" type="ValveConf" visibility="0x00" properties="0x01"/>
   <attribute name="timeEvt" type="QTimeEvt" visibility="0x00" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../2">
     <initial_glyph conn="20,16,5,1,20,7,-2">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Active">
     <entry>static int count = 0;</entry>
     <tran trig="TIMEOUT">
      <action>count = 10;
//blinky, toggle led
count--;
if(!count){
    QTimeEvt_disarm(&amp;me-&gt;timeEvt, 2000, 2000);
}</action>
      <tran_glyph conn="20,42,3,-1,13">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="LOCK_ON" target="../../2">
      <tran_glyph conn="20,40,3,3,-2,-14,2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="VALVE_CONFIG_PARSE">
      <tran_glyph conn="20,44,3,-1,13">
       <action box="0,-2,18,3"/>
      </tran_glyph>
     </tran>
     <state_glyph node="20,34,18,14">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="Wait">
     <entry>Sleep_request(CONFIG_BIT);</entry>
     <exit>Sleep_release(CONFIG_BIT);</exit>
     <tran trig="LOCK_OFF" target="../../1">
      <tran_glyph conn="38,26,1,1,2,14,-2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="20,20,18,10">
      <entry box="0,3,6,2"/>
      <exit box="0,5,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="135,88"/>
   </statechart>
  </class>
  <attribute name="AO_ValveCounter" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;ValveCounter_inst.super;</code>
  </attribute>
  <operation name="ValveCounter_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveCounter * const me = &amp;ValveCounter_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveCounter_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, &amp;me-&gt;super, TIMEOUT_SIG, 0U);</code>
  </operation>
  <attribute name="AO_ValveHandler" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;ValveHandler_inst.super;</code>
  </attribute>
  <operation name="ValveHandler_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveHandler * const me = &amp;ValveHandler_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveHandler_initial));</code>
  </operation>
  <attribute name="AO_ValveConf" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;ValveConf_inst.super;</code>
  </attribute>
  <operation name="ValveConf_ctor" type="void" visibility="0x00" properties="0x00">
   <code>ValveConf * const me = &amp;ValveConf_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;ValveConf_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt, &amp;me-&gt;super, TIMEOUT_SIG, 0U);</code>
  </operation>
 </package>
 <directory name=".">
  <file name="valve_counter.c">
   <text>#include &quot;qpc.h&quot; 
#include &quot;bsp.h&quot;
#include &quot;valve.h&quot;

// ======================== 方向映射表 ========================
typedef struct {
    uint8_t from; // 起始状态
    uint8_t to;   // 目标状态
    int8_t  dir;  // 方向 (+1正转, -1反转)
} TransitionRule;

$declare ${AOs::ValveCounter}

// 方向映射表(64x64, 未定义部分置0)
static const int8_t rules[64][64] = {
    [0x01] = {
        [0x02] = +1, [0x20] = -1, [0x03] = +0, [0x21] = -1
    },
    [0x02] = {
        [0x04] = +1, [0x01] = -1, [0x06] = +0, [0x03] = -1
    },
    [0x04] = {
        [0x08] = +1, [0x02] = -1, [0x0C] = +0, [0x06] = -1
    },
    [0x08] = {
        [0x10] = +1, [0x04] = -1, [0x18] = +0, [0x0C] = -1
    },
    [0x10] = {
        [0x20] = +1, [0x08] = -1, [0x30] = +0, [0x18] = -1
    },
    [0x20] = {
        [0x01] = +1, [0x10] = -1, [0x21] = +0, [0x30] = -1
    },
    [0x03] = {
        [0x02] = +1, [0x01] = -0, [0x07] = +1, [0x21] = -1
    },
    [0x06] = {
        [0x04] = +1, [0x02] = -0, [0x0E] = +1, [0x03] = -1
    },
    [0x0C] = {
        [0x08] = +1, [0x04] = -0, [0x18] = +1, [0x06] = -1
    },
    [0x18] = {
        [0x10] = +1, [0x08] = -0, [0x30] = +1, [0x0C] = -1
    },
    [0x30] = {
        [0x20] = +1, [0x10] = -0, [0x21] = +1, [0x18] = -1
    },
    [0x21] = {
        [0x01] = +1, [0x20] = -0, [0x03] = +1, [0x30] = -1
    },
    [0x07] = {
        [0x03] = -1
    },
    [0x0E] = {
        [0x06] = -1
    }
};

// ======================== 核心逻辑 ========================
// 读取传感器状态（6-bit编码）
static uint8_t read_sensor_state(void)
{
    uint8_t state = 0;
    for (int i = 0; i &lt; HALL_MAX; i++) {
        if (hall_read(i) == true) {
            state |= (1 &lt;&lt; i);
        }
    }
    return state;
}

// 检查是否为合法状态（单或双传感器触发）
static bool is_valid_state(uint8_t* state)
{
    switch (*state) {
        // 单传感器触发
        case 0x01:
        case 0x02:
        case 0x04:
        case 0x08:
        case 0x10:
        case 0x20:
        // 双传感器触发（相邻两个）
        case 0x03:
        case 0x06:
        case 0x0C:
        case 0x18:
        case 0x30:
        case 0x21:
            return true;
        default:
            return false; // 非法状态（如三个传感器同时触发）,无传感器触发
    }
}

// 检查方向（允许1-bit误差）
static int8_t check_direction(uint8_t* old, uint8_t* new)
{
    return rules[*old][*new]; // 直接访问映射表
}

$define ${AOs::AO_ValveCounter}
$define ${AOs::ValveCounter_ctor}
$define ${AOs::ValveCounter}</text>
  </file>
  <file name="valve.h">
   <text>#ifndef __VALVE_H__
#define __VALVE_H__

#define TICKS_PER_ROTATION 6 // 每圈的跳变次数（6磁铁）

$declare ${Shared}
$declare ${AOs::AO_ValveCounter}
$declare ${AOs::ValveCounter_ctor}
$declare ${AOs::AO_ValveHandler}
$declare ${AOs::ValveHandler_ctor}
$declare ${AOs::AO_ValveConf}
$declare ${AOs::ValveConf_ctor}

#endif // __VALVE_H__</text>
  </file>
  <file name="valve_handler.c">
   <text>#include &quot;qpc.h&quot;
#include &quot;bsp.h&quot;
#include &quot;valve.h&quot;

$declare ${AOs::ValveHandler}

$define ${AOs::AO_ValveHandler}
$define ${AOs::ValveHandler_ctor}
$define ${AOs::ValveHandler}</text>
  </file>
  <file name="valve_conf.c">
   <text>#include &quot;qpc.h&quot;
#include &quot;bsp.h&quot;
#include &quot;valve.h&quot;

$declare ${AOs::ValveConf}

$define ${AOs::AO_ValveConf}
$define ${AOs::ValveConf_ctor}
$define ${AOs::ValveConf}</text>
  </file>
 </directory>
</model>
