{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "N32L43x Launch",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/n32l43x.elf",
            "device": "N32L436RB",
            "interface": "swd",
            "svdFile": "${workspaceRoot}/tools/svd/N32L436.svd",
            "runToEntryPoint": "Reset_Handler",
            "rttConfig": {
                "polling_interval": 5,
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
        },
        {
            "name": "N32L43x Attach",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "ipAddress": "192.168.1.111",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/n32l43x.elf",
            "device": "N32L436RB",
            "interface": "swd",
            "svdFile": "${workspaceRoot}/tools/svd/N32L436.svd",
            "runToEntryPoint": "Reset_Handler",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
        },
        {
            "name": "Remote Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "localhost:2331",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/n32l43x.elf",
            "svdFile": "${workspaceRoot}/tools/svd/N32L436.svd",
            "runToEntryPoint": "Reset_Handler",
        }
    ]
}