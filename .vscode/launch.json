    "configurations": [
        {
            "name": "N32L43x Launch",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/n32l43x.elf",
            "device": "N32L436RB",
            "interface": "swd",
            "svdFile": "${workspaceRoot}/tools/svd/N32L436.svd",
            "runToEntryPoint": "Reset_Handler",
            "ipAddress": "192.168.1.3"
        },
        {
            "name": "N32L43x Attach",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/n32l43x.elf",
            "device": "N32L436RB",
            "interface": "swd",
            "svdFile": "${workspaceRoot}/tools/svd/N32L436.svd",
            "runToEntryPoint": "Reset_Handler",
            "ipAddress": "192.168.1.3"
        },
    ]
